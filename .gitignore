# Dependencies
node_modules/

# Local Cloudflare state: D1 database, R2 objects, KV. Contains real content
# and the bootstrapped admin password hash — never commit it.
.wrangler/

# Local assistant/working files.
.workbuddy-ai/

# Screenshot / preview output from verification harnesses.
theme-previews/
.verify/
.aurora-shots/
.shots/

# Secrets and local overrides. `wrangler secret` values go in .dev.vars,
# which must stay on the machine.
.dev.vars
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Local deploy config: wrangler.jsonc with this account's D1 / KV ids filled in.
# The committed wrangler.jsonc keeps REPLACE_WITH_* placeholders so a public
# clone does not publish account-scoped resource ids. Deploy with `-c`.
wrangler.local.jsonc
# Second deployment (another account, R2-less): its own generated config and
# its own ids file, so the shared ids above never get hand-swapped.
wrangler.demo.jsonc
wrangler.ids.demo.json

# The real ids themselves. `scripts/make-local-config.mjs` substitutes these
# into wrangler.jsonc to produce wrangler.local.jsonc, so this is the only
# hand-edited file in the chain and the only one that must stay off the remote.
wrangler.ids.json

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# UI acceptance artifacts (findings JSON, screenshots, dev-server logs) —
# regenerated by every `npm run test:ui`; the issue tracker is the durable
# record, not this directory.
.tmp-ui/

# Theme acceptance screenshots — regenerated from a live dev server on demand;
# the themes themselves are the record, and a browser render of them is a
# build product, not source.
docs/theme-preview/
